{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [{
          "type": "command",
          "command": "code-review-graph update --quiet"
        }],
        "timeout": 5000
      }
    ],
    "SessionStart": [
      {
        "hooks": [{
          "type": "command",
          "command": "code-review-graph status --json"
        }],
        "timeout": 3000
      }
    ],
    "PreToolUse": [
      {
        "hooks": [{
          "type": "command",
          "command": "code-review-graph detect-changes --brief"
        }],
        "timeout": 10000
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/home/equation/.claude/plugins/cache/caveman/caveman/c2ed24b3e5d4/hooks/caveman-statusline.sh\""
  }
}
